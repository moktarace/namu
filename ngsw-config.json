{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "namu",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/native/ic_*.png",
          "/native/icon*",
          "/native/no_items.png",
          "/native/sample*.png",
          "/native/*_light.png",
          "/native/crop_mark_only*.png",
          "/native/vertical_four*.png",
          "/native/walkthrough_*.png",
          "/fonts/**"
        ]
      }
    },
    {
      "name": "media",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/native/stamp_*.png"
        ]
      }
    }
  ],
  "navigationRequestStrategy": "performance"
}
